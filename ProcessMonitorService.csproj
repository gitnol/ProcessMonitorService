<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-ProcessMonitorService-93183342-e5e1-4a24-901a-e28c9c0236b8</UserSecretsId>
    <UseWindowsService>true</UseWindowsService>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.6" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.6" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="9.0.6" />
    <PackageReference Include="Microsoft.Management.Infrastructure" Version="3.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Management" Version="9.0.6" />
  </ItemGroup>

  <ItemGroup>
    <None Update="*.ps1">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!--
    Patchstand der gebuendelten Runtime (docs/security/THREAT_MODEL.md Bedrohung 7, docs/operations/DEPLOYMENT.md).
    Self-contained bringt der Build die Runtime selbst mit; Windows Update patcht sie nicht, der NuGet-Scanner meldet
    den Runtime-Pack nicht. Liegt der aufgeloeste Runtime-Pack unter der Mindestversion, bricht der Build/Publish ab,
    bevor ein Artefakt entsteht. Mindestversion bei jedem .NET-Patch-Day mit Sicherheitsfixes anheben;
    einmalig uebersteuerbar per -p:MinimumBundledRuntimeVersion=<x.y.z>.
  -->
  <PropertyGroup>
    <MinimumBundledRuntimeVersion>9.0.21</MinimumBundledRuntimeVersion>
  </PropertyGroup>

  <Target Name="CheckBundledRuntimePatchLevel"
          AfterTargets="ResolveFrameworkReferences"
          Condition="'$(SelfContained)' == 'true' And '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_BundledNetCoreRuntimePack Include="@(ResolvedRuntimePack)"
                                  Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
    </ItemGroup>
    <PropertyGroup>
      <_BundledNetCoreRuntimeVersion>@(_BundledNetCoreRuntimePack->'%(NuGetPackageVersion)')</_BundledNetCoreRuntimeVersion>
    </PropertyGroup>

    <Error Code="PMS0002"
           Condition="'$(_BundledNetCoreRuntimeVersion)' == '' Or '$(_BundledNetCoreRuntimeVersion.Contains(`;`))' == 'true'"
           Text="Patchstand der gebuendelten Runtime nicht feststellbar (Runtime-Pack Microsoft.NETCore.App: '$(_BundledNetCoreRuntimeVersion)'). Build abgebrochen." />
    <Error Code="PMS0001"
           Condition="$([MSBuild]::VersionLessThan('$(_BundledNetCoreRuntimeVersion)', '$(MinimumBundledRuntimeVersion)'))"
           Text="Gebuendelter Runtime-Pack $(_BundledNetCoreRuntimeVersion) liegt unter der Mindestversion $(MinimumBundledRuntimeVersion) (MinimumBundledRuntimeVersion). Mit aktuellem .NET SDK neu veroeffentlichen." />
    <Message Importance="high"
             Text="Patchstand: gebuendelter Runtime-Pack Microsoft.NETCore.App $(_BundledNetCoreRuntimeVersion) (Mindestversion $(MinimumBundledRuntimeVersion))" />
  </Target>

</Project>